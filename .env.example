# SpeakWell Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# SECURITY KEYS (REQUIRED)
# ============================================================================

# OpenAI API Key for transcription and grading
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Supabase Configuration
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=audio-files

# JWT Secret for authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# CSRF Protection Secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET_KEY=your-csrf-secret-key-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Upload directory for temporary files
UPLOAD_DIR=uploads

# Signed URL expiration time (in seconds)
SIGNED_URL_EXPIRES_IN=7200

# ============================================================================
# SECURITY CONFIGURATION (OPTIONAL)
# ============================================================================

# Rate Limiting (uncomment to customize)
# RATE_LIMIT_GENERAL=100  # requests per minute
# RATE_LIMIT_OPENAI=10
# RATE_LIMIT_UPLOAD=20
# RATE_LIMIT_AUTH=10

# CSRF Token Expiry (in hours)
# CSRF_TOKEN_EXPIRY=24

# Maximum file upload size (in MB)
# MAX_FILE_SIZE=100

# ============================================================================
# DATABASE (If not using Supabase)
# ============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/speakwell

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# For production deployments, consider:
# 1. Using AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault
# 2. Enabling HTTPS only (Strict-Transport-Security)
# 3. Setting ENVIRONMENT=production
# 4. Using a CDN for static files
# 5. Setting up proper logging and monitoring
